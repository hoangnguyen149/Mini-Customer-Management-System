      "name": "Auth",
      "item": [
        {
          "name": "Login (lấy JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", body.token);",
                  "    pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "    pm.test(\"Access token và refresh token đã được lưu\", function () {",
                  "        pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "        pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"<mật khẩu đã set ở AdminSeed:Password — xem README III.3>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Đăng nhập bằng tài khoản admin đã seed (AdminSeed trong User Secrets). Trả về access token JWT (hết hạn sau 15 phút) và refresh token (7 ngày).\n\n- 401: sai username HOẶC sai password — API cố tình không phân biệt 2 trường hợp để chống dò tài khoản.\n- 423: tài khoản tạm khoá sau 5 lần sai liên tiếp (15 phút, cấu hình qua Security:MaxFailedLoginAttempts / Security:LockoutDurationMinutes).\n- 429: vượt rate limit Token Bucket 5 request/phút/IP."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/login"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"expiresAtUtc\": \"2026-09-16T14:15:00Z\",\n  \"username\": \"admin\",\n  \"refreshToken\": \"q8Jk2m...base64-512-bit...Zx0=\"\n}"
            },
            {
              "name": "401 Unauthorized — sai username/password",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/login"
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/problem+json"
                }
              ],
              "body": "{\n  \"type\": \"https://tools.ietf.org/html/rfc7231#section-6.5.1\",\n  \"title\": \"Invalid credentials\",\n  \"status\": 401,\n  \"detail\": \"Tên đăng nhập hoặc mật khẩu không đúng.\",\n  \"traceId\": \"00-...\"\n}"
            },
            {
              "name": "423 Locked — tài khoản tạm khoá do sai nhiều lần",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/login"
              },
              "status": "Locked",
              "code": 423,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/problem+json"
                }
              ],
              "body": "{\n  \"type\": \"https://tools.ietf.org/html/rfc4918#section-11.3\",\n  \"title\": \"Account locked\",\n  \"status\": 423,\n  \"detail\": \"Tài khoản tạm khoá do đăng nhập sai nhiều lần. Vui lòng thử lại sau 15 phút.\",\n  \"traceId\": \"00-...\"\n}"
            },
            {
              "name": "429 Too Many Requests — vượt rate limit",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/login"
              },
              "status": "Too Many Requests",
              "code": 429,
              "_postman_previewlanguage": "json",
              "header": [],
              "body": ""
            }
          ]
        },
        {
          "name": "Refresh token (lấy access token mới)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"token\", body.token);",
                  "    pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "    pm.test(\"Access token và refresh token đã được lưu\", function () {",
                  "        pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "        pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Đổi refresh token lấy access token mới (Blazor tự gọi endpoint này ~2 phút trước khi access token hết hạn — SilentRefreshScheduler).\n\nRotation: mỗi lần gọi thành công, refresh token cũ bị thu hồi và một refresh token mới được cấp (script Tests tự lưu lại). Gửi lại refresh token cũ (replay) → 401. DB chỉ lưu SHA-256 hash của refresh token. Áp dụng chung rate limit với Login."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/refresh"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"expiresAtUtc\": \"2026-09-16T14:15:00Z\",\n  \"username\": \"admin\",\n  \"refreshToken\": \"q8Jk2m...base64-512-bit...Zx0=\"\n}"
            },
            {
              "name": "401 Unauthorized — refresh token hết hạn/đã thu hồi/đã dùng",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/refresh"
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/problem+json"
                }
              ],
              "body": "{\n  \"type\": \"https://tools.ietf.org/html/rfc7235#section-3.1\",\n  \"title\": \"Invalid refresh token\",\n  \"status\": 401,\n  \"detail\": \"Phiên đăng nhập đã hết hạn, vui lòng đăng nhập lại.\",\n  \"traceId\": \"00-...\"\n}"
            }
          ]
        },
