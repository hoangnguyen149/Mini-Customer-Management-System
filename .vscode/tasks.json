{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "command": "dotnet",
      "type": "process",
      "args": ["restore", "${workspaceFolder}/CustomerManager.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CustomerManager.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "dependsOn": "restore",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "ef-migrations-add-InitialCreate",
      "command": "dotnet",
      "type": "process",
      "args": [
        "ef", "migrations", "add", "InitialCreate",
        "--project", "${workspaceFolder}/src/CustomerManager.Infrastructure",
        "--startup-project", "${workspaceFolder}/src/CustomerManager.WebApi",
        "--output-dir", "Persistence/Migrations"
      ],
      "problemMatcher": [],
      "dependsOn": "build"
    },
    {
      "label": "ef-database-update",
      "command": "dotnet",
      "type": "process",
      "args": [
        "ef", "database", "update",
        "--project", "${workspaceFolder}/src/CustomerManager.Infrastructure",
        "--startup-project", "${workspaceFolder}/src/CustomerManager.WebApi"
      ],
      "problemMatcher": []
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/CustomerManager.sln"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
