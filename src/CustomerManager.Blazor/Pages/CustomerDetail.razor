@page "/customers/{Id:guid}"
@attribute [Authorize]
@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.Unicode
@inject ICustomerApiService CustomerApiService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (_isLoading)
{
    <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="2">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudStack>
}
else if (_loadError)
{
    <MudAlert Severity="Severity.Error" Dense="true">
        Không thể tải thông tin khách hàng.
        <MudButton Variant="Variant.Text" Color="Color.Error" Class="ml-2" OnClick="LoadAsync">Thử lại</MudButton>
    </MudAlert>
}
else if (_customer is not null)
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-4"
              OnClick="@(() => Navigation.NavigateTo("/customers"))">
        Quay lại danh sách
    </MudButton>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-6 d-flex flex-column align-center" Elevation="2">
                <MudAvatar Color="@AvatarHelper.GetColor(_customer.FullName)" Style="width:96px;height:96px;font-size:2rem;" Class="mb-4">
                    @AvatarHelper.GetInitials(_customer.FullName)
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="text-center">@_customer.FullName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Mã KH: @_customer.CustomerCode</MudText>
                <MudChip T="string" Color="@(_customer.IsActive ? Color.Success : Color.Default)" Variant="Variant.Filled">
                    @(_customer.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
                </MudChip>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                          Class="mt-4" FullWidth="true" OnClick="OpenEditDialogAsync">
                    Chỉnh sửa
                </MudButton>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-6 mb-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Thông tin liên hệ</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                        <MudText>@_customer.Email</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Số điện thoại</MudText>
                        <MudText>@_customer.PhoneNumber</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ngày sinh</MudText>
                        <MudText>@_customer.DateOfBirth.ToString("dd/MM/yyyy")</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-6" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Thông tin hệ thống</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ngày tạo</MudText>
                        <MudText>@_customer.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Người tạo</MudText>
                        <MudText>@_customer.CreatedBy</MudText>
                    </MudItem>
                    @if (_customer.UpdatedAt is not null)
                    {
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cập nhật lần cuối</MudText>
                            <MudText>@_customer.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Người cập nhật</MudText>
                            <MudText>@_customer.UpdatedBy</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-6 mt-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Lịch sử thay đổi</MudText>

                @if (_isLoadingAuditLogs)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
                }
                else if (_auditLogs.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa có lịch sử thay đổi.</MudText>
                }
                else
                {
                    <MudExpansionPanels Elevation="0">
                        @foreach (var log in _auditLogs)
                        {
                            <MudExpansionPanel Text="@($"{TranslateAction(log.Action)} — {log.UserName} — {log.Timestamp.ToLocalTime():dd/MM/yyyy HH:mm:ss}")">
                                <MudGrid>
                                    @if (!string.IsNullOrEmpty(log.OldValues))
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Giá trị cũ</MudText>
                                            <pre class="audit-json">@FormatJson(log.OldValues)</pre>
                                        </MudItem>
                                    }
                                    <MudItem xs="12" sm="6">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Giá trị mới</MudText>
                                        <pre class="audit-json">@FormatJson(log.NewValues)</pre>
                                    </MudItem>
                                </MudGrid>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CustomerDetailDto? _customer;
    private bool _isLoading = true;
    private bool _loadError;
    private List<AuditLogDto> _auditLogs = new();
    private bool _isLoadingAuditLogs = true;

    private Guid? _loadedId;

    /// <summary>OnParametersSet (not OnInitialized): navigating from
    /// /customers/{a} to /customers/{b} reuses this component instance, and
    /// OnInitialized would keep showing customer a.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        await Task.WhenAll(LoadAsync(), LoadAuditLogsAsync());
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = false;
        StateHasChanged();

        try
        {
            _customer = await CustomerApiService.GetByIdAsync(Id);
        }
        catch (ApiException)
        {
            _loadError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAuditLogsAsync()
    {
        _isLoadingAuditLogs = true;
        try
        {
            _auditLogs = (await CustomerApiService.GetAuditLogsAsync(Id)).ToList();
        }
        catch (ApiException)
        {
            _auditLogs = new List<AuditLogDto>();
        }
        finally
        {
            _isLoadingAuditLogs = false;
        }
    }

    private static string TranslateAction(string action) => action switch
    {
        "Added" => "Tạo mới",
        "Modified" => "Cập nhật",
        "Deleted" => "Xóa",
        _ => action
    };

    /// <summary>The default encoder escapes every non-ASCII character, which
    /// turned "Nguyễn" into "Nguy\u1EC5n" in the history panel. Razor
    /// HTML-encodes the rendered text anyway, so JSON-level escaping adds no
    /// safety here.</summary>
    private static readonly JsonSerializerOptions PrettyJson = new()
    {
        WriteIndented = true,
        Encoder = JavaScriptEncoder.Create(UnicodeRanges.All)
    };

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return string.Empty;
        }

        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document, PrettyJson);
        }
        catch (JsonException)
        {
            return json;
        }
    }

    private async Task OpenEditDialogAsync()
    {
        var parameters = new DialogParameters<CustomerFormDialog> { { x => x.CustomerId, Id } };
        var dialog = await DialogService.ShowAsync<CustomerFormDialog>("Cập nhật khách hàng", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Đã cập nhật khách hàng.", Severity.Success);
            // The edit just wrote a new audit entry — refresh both panels.
            await Task.WhenAll(LoadAsync(), LoadAuditLogsAsync());
        }
    }
}
