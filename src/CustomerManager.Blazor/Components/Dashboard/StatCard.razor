<MudPaper Class="stat-card pa-4" Elevation="2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
        <MudStack Spacing="1">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Label</MudText>
            @if (Loading)
            {
                <MudSkeleton Width="70px" Height="40px" />
            }
            else
            {
                <MudText Typo="Typo.h4">@_displayValue@Suffix</MudText>
            }
        </MudStack>
        <MudAvatar Color="@Color" Variant="Variant.Filled">
            <MudIcon Icon="@Icon" />
        </MudAvatar>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = MudBlazor.Icons.Material.Filled.Info;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public int Value { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public string Suffix { get; set; } = string.Empty;

    private int _displayValue;
    private int _lastAnimatedValue = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (Loading || Value == _lastAnimatedValue)
        {
            return;
        }

        _lastAnimatedValue = Value;
        await AnimateToAsync(Value);
    }

    /// <summary>~400ms count-up. Short enough to stay readable without a
    /// prefers-reduced-motion check — nothing here moves position, only a number.</summary>
    private async Task AnimateToAsync(int target)
    {
        const int steps = 20;
        const int stepDelayMs = 20;
        var start = _displayValue;

        for (var i = 1; i <= steps; i++)
        {
            _displayValue = start + (int)((target - start) * (i / (double)steps));
            StateHasChanged();
            await Task.Delay(stepDelayMs);
        }

        _displayValue = target;
        StateHasChanged();
    }
}
