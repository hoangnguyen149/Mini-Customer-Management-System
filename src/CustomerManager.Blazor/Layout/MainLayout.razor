@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="1">
                <MudText Typo="Typo.h6">CustomerManager</MudText>
                <MudSpacer />
                <MudText Class="mr-4" Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LogoutAsync">Đăng xuất</MudButton>
            </MudAppBar>
        </Authorized>
    </AuthorizeView>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    [Inject] private IAuthApiService AuthApiService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task LogoutAsync()
    {
        await AuthApiService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: false);
    }
}
